{
  "name": "@conduits/gateway-service",
  "version": "0.5.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "gateway": "NODE_ENV=production node --env-file-if-exists=.env --import remix/node-tsx cli.ts gateway",
    "auth:google": "node --env-file-if-exists=.env --import remix/node-tsx cli.ts auth google",
    "sheets:create": "node --env-file-if-exists=.env --import remix/node-tsx cli.ts sheets create",
    "start": "NODE_ENV=production node --env-file-if-exists=.env --import remix/node-tsx server.ts",
    "test": "NODE_ENV=test remix test",
    "test:all": "NODE_ENV=test remix test",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=24.3.0"
  },
  "dependencies": {
    "@conduits/config": "*",
    "@conduits/gateway": "*",
    "remix": "^3.0.0-rc.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2"
  }
}
