# Copy to .env before doing anything else in this directory — even
# the one-time `conduits auth google` step reads it. .env is
# gitignored — never commit it.
#
# There are two independent things this file can hold. See README.md's
# "How credentials actually flow" for the full picture; short version:

# 1. Needed ONLY to run `conduits auth google` (a one-time setup
# command, not something the running gateway itself ever reads).
# Google Cloud Console → APIs & Services → Credentials → OAuth client
# ID, type "Desktop app". CLIENT_SECRET may be blank — some Desktop
# client downloads don't include one.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 2. Whatever plain secrets YOUR OWN conduits.yaml's `env:` references
# name — these are NOT fixed names this file can list for you. If your
# conduits.yaml has `credential: env:FASTMAIL_TOKEN` or
# `bearerToken: {value: env:CONTACT_FORM_TOKEN}`, you add exactly those
# two lines here yourself, e.g.:
#
# FASTMAIL_TOKEN=
# CONTACT_FORM_TOKEN=
#
# The gateway reads these every time it starts (and, for a
# `credential:` reference, again on every request that needs it) — a
# missing one fails startup immediately, naming the variable.

# Optional infrastructure vars — uncomment only if you need a
# non-default value.
# CONDUITS_CONFIG_PATH=./conduits.yaml
# CONDUITS_CREDENTIAL_STORE_PATH=~/.conduits/credentials.json
# PORT=8787

# Required. Rows a list read (GET on a conduit) returns when it gives no
# `limit`, and the largest `limit` it may give.
CONDUITS_LIST_DEFAULT_LIMIT=1000
CONDUITS_LIST_MAX_LIMIT=1000

# Required. How long list reads may reuse a sheet tab's contents, in
# milliseconds, so paging through a large sheet reads it from Google
# once. Writes through this gateway clear it at once; edits made in
# Google Sheets show after it expires.
CONDUITS_SHEETS_READ_CACHE_MS=10000

# Required. Requests per minute this gateway sends to Google Sheets, for
# reads and for writes separately: in all, and per Google account. Keep
# them below Google's quotas (by default 300 per project and 60 per user
# per minute), so callers get a 503 with Retry-After before Google
# refuses every conduit.
CONDUITS_SHEETS_REQUESTS_PER_MINUTE=240
CONDUITS_SHEETS_REQUESTS_PER_MINUTE_PER_ACCOUNT=50

# Required. The throttle: requests one client address may make to one
# conduit in each window (milliseconds); more get a 429 with
# Retry-After. An address that makes BAN_AFTER requests in one window
# is refused for BAN_MS milliseconds.
CONDUITS_THROTTLE_REQUESTS=5
CONDUITS_THROTTLE_WINDOW_MS=1000
CONDUITS_THROTTLE_BAN_AFTER=50
CONDUITS_THROTTLE_BAN_MS=600000

# Optional. The IPs of servers that call conduits for their own visitors
# and send each visitor's IP in X-Forwarded-For, comma-separated. The
# allowlist and the throttle then see the visitor, not the server.
# CONDUITS_TRUSTED_FORWARDERS=
